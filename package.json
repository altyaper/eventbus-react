{
  "name": "@altyaper/eventbus-react",
  "version": "0.1.0",
  "description": "React hooks for listening to an eventbus server in real time, plus a server-side publisher.",
  "license": "MIT",
  "author": "altyaper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altyaper/eventbus-react.git"
  },
  "homepage": "https://github.com/altyaper/eventbus-react#readme",
  "bugs": {
    "url": "https://github.com/altyaper/eventbus-react/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release:patch": "npm version patch -m \"Release v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"Release v%s\" && git push --follow-tags"
  },
  "keywords": [
    "eventbus",
    "react",
    "phoenix",
    "websocket",
    "pubsub",
    "realtime"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "phoenix": "^1.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
